# Server-only Arkiv access key. Never prefix with NEXT_PUBLIC_.
# Get a free key at https://hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=

# Optional RPC override. Defaults to the verified Rabdi Testnet endpoint:
# https://rpc.rabdi.db-chain.testnet.arkiv.network
# The access key above is appended to this URL as its final path segment.
ARKIV_RPC_URL=

# Optional. Clamped to 3000-60000 ms. Defaults to 15000.
ARKIV_QUERY_TIMEOUT_MS=15000

# Full HTTPS Polygon PoS Mainnet read endpoint, including the provider key.
POLYGON_RPC_URL=

# Public address of the dedicated local ingestion signer.
AXIS_INDEXER_ADDRESS=

# Public local publisher address used to discover the optional prebuilt dashboard.
# Configured by npm run dashboard:seed; no private key is exposed to the browser.
AXIS_PREBUILT_PUBLISHER=

# Store AXIS_INDEXER_PRIVATE_KEY only in ignored .env.worker.local.
# The website never loads that file. The worker loads it on startup.
