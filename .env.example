# Swarm public snapshots (server only).
# bee: private node + batch below. public-gateway: official gateway provides postage;
# leave BEE_URL, POSTAGE_BATCH_ID and API_TOKEN empty. Actual batch/retention unknown.
SWARM_UPLOAD_MODE=bee
# report includes standalone HTML; data includes CSV/JSON only.
SWARM_SNAPSHOT_PROFILE=report
# Keep the full Bee API private. For hosted apps, provide a protected reachable endpoint.
SWARM_BEE_URL=
SWARM_POSTAGE_BATCH_ID=
SWARM_API_TOKEN=
# Buyer address or donor details are needed for the prize submission.
SWARM_BATCH_OWNER_ADDRESS=
SWARM_BATCH_DONOR=
SWARM_UPLOAD_SERVICE_NAME=
# Wallets authorized to consume this batch; defaults to AXIS_INDEXER_ADDRESS.
SWARM_ALLOWED_UPLOADERS=
# Read gateway: base URL with /bzz routes, or a {cid} subdomain template.
# The bzz.limo CID route served our report; bzz.link/API HTML needed approval.
SWARM_READ_GATEWAY_URL=https://{cid}.bzz.limo
SWARM_MAX_UPLOADS_PER_DAY=10

# Separate dashboard-only viewer's public production origin (no /d/... suffix).
# Prepare it with npm run viewer:prepare and deploy .axis/dashboard-viewer to Vercel once.
AXIS_DASHBOARD_VIEWER_URL=

# Vercel frontend only: HTTPS origin of the persistent AWS API.
# Leave empty on the AWS API server to avoid forwarding requests to itself.
AXIS_API_ORIGIN=
# AWS API only: exact HTTPS production frontend origin allowed for mutations.
AXIS_FRONTEND_ORIGIN=

# Server-only Arkiv access key. Never prefix with NEXT_PUBLIC_.
# Get a free key at https://hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=

# Optional RPC override. Defaults to the verified Rabdi Testnet endpoint:
# https://rpc.rabdi.db-chain.testnet.arkiv.network
# The access key above is appended to this URL as its final path segment.
ARKIV_RPC_URL=

# Optional. Clamped to 3000-60000 ms. Defaults to 15000.
ARKIV_QUERY_TIMEOUT_MS=15000

# Full HTTPS Polygon PoS Mainnet read endpoint, including the provider key.
POLYGON_RPC_URL=

# Bulk CLI minimum delay between source RPC calls (milliseconds; default 750).
# This paces bulk reads alongside the live importer and reduces provider rate-limit errors.
AXIS_BULK_RPC_INTERVAL_MS=750

# Public address of the dedicated local ingestion signer.
AXIS_INDEXER_ADDRESS=


# Store AXIS_INDEXER_PRIVATE_KEY only in ignored .env.worker.local.
# The website never loads that file. The worker loads it on startup.

# Server-only English-to-query translation in Query Studio.
OPENROUTER_API_KEY=
# Must support structured outputs. Default: google/gemini-2.5-flash.
OPENROUTER_MODEL=google/gemini-2.5-flash
